-# locals: (cli:, count_input: true)
-# anchors for deep links: #VOC00618 (inventory number) and #2344 (WINK id)
- inventory_number = cli.item.inventory_number.presence
%div.checklist_item{id: inventory_number || cli.item.id.to_s, data: { search: [cli.item.name_with_model, inventory_number, cli.item.serial_number, cli.item.id].compact.join(" ") }}
  - if inventory_number
    %a{id: cli.item.id.to_s}
  = check_box_tag("checked_check_list_items_#{cli.id}", cli.id, cli.checked, { name: "check_list[checked_check_list_items][]"})
  %label{ for: "checked_check_list_items_#{cli.id}" }
    - details = [cli.item.manufacturer, cli.item.model].reject { |v| v.blank? || v == "-" }.join(" ")
    - if cli.item.item_type
      %span.item_type= cli.item.item_type.name
    %span.item_name= cli.item.name
    - if details.present?
      %span.item_details= details
    - if cli.item.item
      %span.item_parent= "↳ part of #{cli.item.item.name}"
    %span.item_ids
      - if inventory_number
        %span.inventory_number= inventory_number
      - if cli.item.serial_number.present? && cli.item.serial_number != "n.a."
        %span.serial_number= "S/N #{cli.item.serial_number}"
    - if cli.item.missing? or cli.item.broken?
      %span.item_flags
        %span.mark.missing= "missing" if cli.item.missing?
        %span.mark.broken= "broken" if cli.item.broken?
  - if count_input && cli.item.countable
    = render partial: 'count_field', locals: { cli: cli, expected: 1 }
