- content_for :title, "Checklist #{@check_list.case.name} - (#{@check_list.event.name}) - "

%h2
  Checklist 
  %a{href: case_path(@check_list.case), target: '_blank'}= @check_list.case.name
  at
  %a{href: event_path(@check_list.event), target: '_blank'}= @check_list.event.name

%div.check_list_intro
  %p
    Go through the set and tick every item that is there and works.
    Tap an item to tick it. Identical items without inventory number are stacked
    (e.g. <b>3×</b>): every tap ticks the next one, a long press ticks all of them,
    <i>unfold</i> lists them one by one. A double-click on a headline ticks a whole section.
  %p
    The filter finds items by name, model, inventory number or serial number.
    Broken or missing items stay marked on their card; add details on the
    item page afterwards. Press <b>later</b> next to a headline to move that section to the
    end of the list; a long press on the headline (or a click on its triangle) folds the
    section. Order and folded sections are remembered on this device.
  %p
    <b>Save</b> stores your ticks and stays here, <b>Return</b> stores them and
    shows the result. Tick <i>Finished checking?</i> at the bottom when you are done.
    Until you save, your changes are only kept on this device (local storage of
    your browser), so you do not lose them if the connection drops. When you leave
    the page with unsaved changes you are asked whether to save them first.

.filters
  %label{for: 'item_filter'}= 'Item filter:'
  .value
    %img.spinner{:src => asset_path('spinner.gif'), :alt => 'Loading...'}
    %input#item_filter{:type => 'text'}
    %img#item_filter_clear{:src => asset_path('icons/cross.png'), :alt => 'Clear'}

= render partial: 'record_errors', locals: { record: @check_list }

= form_for(@check_list.check_list_items, as: :check_list_items, url: check_list_path(@check_list), method: 'PUT', html: { data: { check_list_id: @check_list.id } }) do |f|
  = render partial: 'form_check_item', locals: {f: f}, object: @check_list_item
  %div.floating_form_actions
    = f.submit "Save"
    = f.submit "Return", name: 'return'
    = link_to 'Cancel', check_list_path(@check_list)


:javascript
  var item_filter_timer;
  var item_filter_value = '';

  $(function() {
    // Hide all items which do not match the given regular expression
    // If all items are hidden in a shelf unit, the whole unit becomes hidden
    var item_filter_action = function() {

      var filter = $('#item_filter').val();
      var pattern;
      try {
        pattern = new RegExp(filter, 'i');
      } catch (e) {
        // not a valid regular expression: search for the literal text
        pattern = new RegExp(filter.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'i');
      }

      $('.noborder').each(function() {
        var shown_count = 0;

        $(this).find('.checklist_item').each(function() {
          // search name, model, inventory number, serial number and WINK id
          var haystack = $(this).attr('data-search') + ' ' + $(this).find('label').text();
          var matches = !!haystack.match(pattern);
          $(this).toggleClass('filtered_out', !matches);
          if (matches) { shown_count += 1; }
        });

        // a stack is shown as long as one of its items matches
        $(this).find('.checklist_stack').each(function() {
          $(this).toggleClass('filtered_out', $(this).find('.checklist_item:not(.filtered_out)').length == 0);
        });

        $(this).toggleClass('filtered_out', shown_count == 0);
      });

      item_filter_value = $('#item_filter').val();

      if ($('#item_filter').val() != '') {
        $('#item_filter_clear').css('visibility', 'visible');
        //$('h3').css('display', 'none');
      } else {
        $('#item_filter_clear').css('visibility', 'hidden');
        //$('h3').css('display', 'block');
      }

      $('.spinner').css('visibility', 'hidden');
    };


    // Button shit

    // Amount of milliseconds for the finish-typing-timeout
    var item_filter_timeout = 500;

    // When a key is released, a timeout for filtering is activated
    $('#item_filter').keyup(function() {
      if (item_filter_value != $('#item_filter').val()) {
        item_filter_timer = setTimeout(item_filter_action, item_filter_timeout);
        $('.spinner').css('visibility', 'visible');
      }
    });

    // When a key is pressed, a running timeout for filtering gets stopped
    $('#item_filter').keydown(function() {
      clearTimeout(item_filter_timer);
      $('.spinner').css('visibility', 'hidden');
    });

    $('#item_filter_clear').click(function() {
      $(this).css('visibility', 'hidden');
      $('#item_filter').val('');
      item_filter_action();
    });
  });


  $(document).ready(function() {
    // Show "(checked/total)" in the headline of a section
    var update_progress = function(section) {
      var checked = section.find('.checklist_item input[type="checkbox"]:checked').length;
      var total = section.find('.progress').data('total');
      section.find('.progress').text('(' + checked + '/' + total + ')');
    };

    // Stacks of identical items: "checked/total" and colour
    var update_stack = function(stack) {
      var boxes = stack.find('input[type="checkbox"]');
      var checked = boxes.filter(':checked').length;
      stack.find('.stack_progress').text(checked + '/' + boxes.length);
      // jQuery's .css() does not handle custom properties (older versions): set it natively
      stack.find('.stack_bar').each(function() {
        this.style.setProperty('--progress', Math.round(100 * checked / boxes.length) + '%');
      });
      stack.find('.stack_state').attr('title', checked + '/' + boxes.length + ' checked');
      stack.toggleClass('all_checked', checked == boxes.length);
      stack.toggleClass('partial', checked > 0 && checked < boxes.length);
    };

    $('.noborder .checklist_item input[type="checkbox"]').change(function() {
      update_progress($(this).closest('.noborder'));
      var stack = $(this).closest('.checklist_stack');
      if (stack.length) { update_stack(stack); }
    });
    $('.checklist_stack').each(function() { update_stack($(this)); });

    // Click on a stack checks its next unchecked item; when everything is
    // checked, a click unchecks the whole stack again.
    $('.stack_summary').on('click keydown', function(event) {
      if (event.type == 'keydown' && event.key != 'Enter' && event.key != ' ') { return; }
      event.preventDefault();
      // the click that ends a long press must not check/uncheck anything again
      if (event.type == 'click' && $(this).data('long_pressed')) {
        $(this).data('long_pressed', false);
        return;
      }
      var stack = $(this).closest('.checklist_stack');
      var inputs = stack.find('.checklist_item:not(.filtered_out) input[type="checkbox"]');
      var open = inputs.filter(':not(:checked)');

      if (open.length) {
        open.first().prop('checked', true).trigger('change');
      } else {
        inputs.prop('checked', false).trigger('change');
      }
    });

    // Long press (or holding the mouse button) on a stack checks all its items at once.
    var LONG_PRESS_MS = 600;
    $('.stack_summary').each(function() {
      var summary = $(this);
      var timer = null;
      var start = null;

      var cancel = function() { clearTimeout(timer); timer = null; };

      summary.on('pointerdown', function(event) {
        if (event.button > 0 || $(event.target).closest('.stack_toggle').length) { return; }
        start = { x: event.clientX, y: event.clientY };
        cancel();
        timer = setTimeout(function() {
          timer = null;
          var inputs = summary.closest('.checklist_stack')
                              .find('.checklist_item:not(.filtered_out) input[type="checkbox"]');
          inputs.filter(':not(:checked)').prop('checked', true).trigger('change');
          summary.data('long_pressed', true);
          if (navigator.vibrate) { navigator.vibrate(30); }
        }, LONG_PRESS_MS);
      });
      // scrolling or dragging is not a long press
      summary.on('pointermove', function(event) {
        if (timer && start && Math.hypot(event.clientX - start.x, event.clientY - start.y) > 10) { cancel(); }
      });
      summary.on('pointerup pointercancel pointerleave', cancel);
      // no context menu / text selection from a long press on touch devices
      summary.on('contextmenu', function(event) { if (summary.data('long_pressed')) { event.preventDefault(); } });
    });

    $('.stack_toggle').click(function(event) {
      event.preventDefault();
      event.stopPropagation();
      var stack = $(this).closest('.checklist_stack');
      stack.toggleClass('expanded');
      $(this).text(stack.hasClass('expanded') ? 'fold' : 'unfold');
    });

    // Deep link (#VOC00618 or #2344): open the stack the item is in and highlight it
    var open_deep_link = function() {
      var target = document.getElementById(decodeURIComponent(window.location.hash.substring(1)));
      if (!target) { return; }
      var stack = $(target).closest('.checklist_stack');
      if (stack.length) {
        stack.addClass('expanded');
        stack.find('.stack_toggle').text('fold');
      }
      $('.checklist_item.highlight').removeClass('highlight');
      $(target).closest('.checklist_item').addClass('highlight');
      target.scrollIntoView({ block: 'center' });
    };
    open_deep_link();
    $(window).on('hashchange', open_deep_link);

    // Double-click on a headline checks the whole section (only the items
    // currently matching the filter). If all of them are already checked,
    // they get unchecked again.
    $('h3.section_heading').dblclick(function() {
      var section = $(this).closest('.noborder');
      var inputs = section.find('.checklist_item:not(.filtered_out) input[type="checkbox"]');
      var all_checked = inputs.filter(':not(:checked)').length == 0;

      // "change" updates progress, stacks and the copy in the local storage
      inputs.prop('checked', !all_checked).trigger('change');

      // drop the text selection a double-click causes
      if (window.getSelection) { window.getSelection().removeAllRanges(); }
    });
  });
