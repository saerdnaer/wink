- content_for :title, "Checklist #{@check_list.case.name} - (#{@check_list.event.name}) - "

%h2= "Checklist #{@check_list.case.name} - (#{@check_list.event.name})"

-# filled by check_list_offline.js when this device has unsaved changes for this list
#unsaved_notice.offline_banner{style: "display:none", data: { check_list_id: @check_list.id, edit_url: edit_check_list_path(@check_list), state: @check_list.check_list_items.includes(:item).each_with_object({}) { |cli, state| state[cli.id] = cli.checked; state["count:#{cli.id}"] = cli.count.to_s if cli.countable? }.to_json }}

%ol.properties
  %li
    %label Advisor:
    %span.advisor= @check_list.advisor
  - if @check_list.comment.present?
    %li
      %label Comment:
      %span.comment= @check_list.comment
  %br
  %li
    %label Event:
    %span.event
      %a{href: event_path(@check_list.event)}= @check_list.event.name
  %li
    %label Set:
    %span.case
      %a{href: case_path(@check_list.case)}= @check_list.case.name
  %br
  %li
    %label Status:
    %span.check_status
      - if @check_list.checked
        = "Checklist already checked!"
      - else
        = "Please finisch checking…"
  - unless @check_list.checked
    %li
      %label Actions
      %span.actions
        %a{href: edit_check_list_path(@check_list)} Check me!
        = link_to "Finish", finish_check_list_path(@check_list), method: :post, class: "finish_check_list", data: { confirm: "Finish this checklist? Items not checked so far are marked as missing." }

- count_results = @check_list.count_results
- if count_results.any?
  %h3 Counted items
  %table.count_results
    %thead
      %tr
        %th Item
        %th Counted
        %th Expected
        %th Difference
    %tbody
      - count_results.each do |result|
        %tr{class: (result.difference.positive? ? "count_over" : (result.difference.negative? ? "count_under" : "count_ok"))}
          %td= result.name
          %td= result.counted
          %td= result.expected
          %td= result.difference.zero? ? "as expected" : format("%+d", result.difference)

%ul
  -# TODO: Move items select to controller
  - items = @check_list.items_without_shelfs.group_by{ |ci| ci.checked }
  - if items[false] && !@check_list.started?
    %h3= "Not started yet (#{items[false].count} items to check)"
    %p
      Nothing was checked so far.
      - unless @check_list.checked
        %a{href: edit_check_list_path(@check_list)} Start checking
  - elsif items[false]
    %h3= "#{@check_list.checked ? 'Missing' : 'Not checked yet'} (#{items[false].count})"
    - items[false].group_by{|ci| ci.item.name}.each do |name,citems|
      - citems.each do |ci|
        %li.check_list_entry{id: ci.item.inventory_number.presence || ci.item.id.to_s}
          - if ci.item.inventory_number.present?
            %a{id: ci.item.id.to_s}
          = "#{ci.item.name_with_model}"

  - if items[true]
    %h3= "Checked (#{items[true].count})"
    %ul
    - items[true].group_by{|ci| ci.item.name}.each do |name,citems|
      %li
        - citems.each do |ci|
          %a{id: ci.item.id.to_s}
          - if ci.item.inventory_number.present?
            %a{id: ci.item.inventory_number}
        - if ( citems.count == 1 || citems.group_by{|ci| ci.item.model}.count == 1 )
          = "#{name} " + ("✔" * citems.count)
        - else
          = "#{name}"
          %ul
            - citems.group_by{|ci| ci.item.model}.each do |model,instances|
              %li
                ="#{model}" 
                - instances.each do |i|
                  = "✔" 
