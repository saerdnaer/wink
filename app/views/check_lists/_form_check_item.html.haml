- @grouped_items.sort_by{|location,items| "#{location}" }.each do |location,items|
  %p.export_cases
    .noborder
      - if location.empty?
        %a{name: Digest::MD5.hexdigest("nolocation")}
        %h3.section_heading{id: Digest::MD5.hexdigest("nolocation"), title: "Double-click: check / uncheck the whole section. Long press: fold / unfold."}
          %span.fold_toggle{role: "button", tabindex: 0, "aria-expanded": "true", title: "Fold / unfold"} ▼
          no location
          %span.progress{data: { total: items.count }}= "(#{items.count(&:checked)}/#{items.count})"
          %button.section_later{type: "button", title: "Move this section to the end"} later
      - else
        %p.export_cases
          %a{name: "#{Digest::MD5.hexdigest(location)}"}
          %h3.section_heading{id: Digest::MD5.hexdigest(location), title: "Double-click: check / uncheck the whole section. Long press: fold / unfold."}
            %span.fold_toggle{role: "button", tabindex: 0, "aria-expanded": "true", title: "Fold / unfold"} ▼
            = location
            %span.progress{data: { total: items.count }}= "(#{items.count(&:checked)}/#{items.count})"
            %button.section_later{type: "button", title: "Move this section to the end"} later

      %div.checklist_group
        -# TODO: Be able to mark broken items with comments.
        - sorted = items.sort_by{|cli| "#{cli.item.item&.name}#{cli.item.name}.#{format('%05.1f', cli.item.model.to_f)}" }
        -# items with the same title (and parent) are stacked on each other, even if only
        -# some of them have a model, but only when they have neither an inventory number
        -# nor a serial number
        - sorted.group_by{ |cli| cli.item.inventory_number.blank? && cli.item.serial_number.to_s.strip.in?(["", "n.a."]) ? [cli.item.name.to_s.strip.downcase, cli.item.item_id] : cli.id }.each_value do |stack|
          - if stack.size == 1
            = render partial: 'checklist_card', locals: { cli: stack.first }
          - else
            - first = stack.first.item
            -# manufacturer/model of all items, each variant only once
            - details = stack.map { |cli| [cli.item.manufacturer, cli.item.model].reject { |v| v.blank? || v == "-" }.join(" ") }.reject(&:blank?).uniq.join(" · ")
            - types = stack.map { |cli| cli.item.item_type&.name }.uniq
            %div.checklist_stack{data: { total: stack.size }}
              %div.stack_summary{role: "button", tabindex: 0, title: "Click: check next item of the stack. Long press: check all"}
                - if types.size == 1 && types.first
                  %span.item_type= types.first
                %span.item_name
                  %span.stack_count= "#{stack.size}×"
                  = first.name
                - if details.present?
                  %span.item_details= details
                - if first.item
                  %span.item_parent= "↳ part of #{first.item.name}"
                %span.stack_status
                  -# progress bar while checking; "2/2 checked" once everything is checked
                  %span.stack_state{title: "#{stack.count(&:checked)}/#{stack.size} checked"}
                    %span.stack_bar{style: "--progress: #{(100.0 * stack.count(&:checked) / stack.size).round}%"}
                    %span.stack_progress= "#{stack.count(&:checked)}/#{stack.size}"
                    %span.stack_label checked
                  %a.stack_toggle{href: "#", title: "Fold / unfold the single items"} unfold
              %div.stack_items
                - stack.each do |cli|
                  = render partial: 'checklist_card', locals: { cli: cli }

.noborder
  %table
    %tbody
      %tr
        %td
          = check_box(:check_list, :checked, checked_value: true, unchecked_value: false)
        %td
          %label{ for: "check_list_checked" }= "Finished checking?"
