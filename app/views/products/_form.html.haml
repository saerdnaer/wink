%p
  %label{for: 'product_name'}= "Name:"
  %label.hint Audio cable XLR 3m
  = f.text_field :name
%p
  %label{for: 'product_description'}= "Description:"
  %label.hint Short description, e.g. "Camera"
  = f.text_field :description, maxlength: 120
%p
  %label{for: 'product_details'}= "Details:"
  %label.hint Long description and general data, e.g. technical specifications
  = f.text_area :details, rows: 6
%p
  %label{for: 'product_manufacturer'}= "Manufacturer:"
  %label.hint Pick an organisation (linked by name) or type any text
  = f.text_field :manufacturer, list: "manufacturer_organisations", autocomplete: "off"
  -# manufacturers first, then all other organisations; the field stays a free text
  %datalist#manufacturer_organisations
    - Organisation.existing.order(Arel.sql("CASE WHEN 'manufacturer' = ANY (roles) THEN 0 ELSE 1 END"), :name).each do |organisation|
      %option{value: organisation.name}= organisation.roles.include?("manufacturer") ? "" : "(#{organisation.roles.join(', ').presence || 'no role'})"
%p
  %label{for: 'product_model'}= "Model:"
  = f.text_field :model
%p
  %label{for: 'product_product_number'}= "Product number:"
  = f.text_field :product_number
%p
  %label{for: 'product_gtin'}= "GTIN (EAN/UPC):"
  = f.text_field :gtin, inputmode: "numeric"
%p
  %label{for: 'product_asin'}= "ASIN:"
  = f.text_field :asin
%p
  %label{for: 'product_price'}= "Purchase price:"
  = f.number_field :price, step: "0.01", min: 0
%p
  %label{for: 'product_insurance_value'}= "Replacement value:"
  = f.number_field :insurance_value, step: "0.01", min: 0
%p
  %label{for: 'product_product_link'}= "Product link:"
  = f.text_field :product_link
%p
  %label{for: 'product_web_url'}= "Web page:"
  %label.hint Product page of the manufacturer, wiki page, ...
  = f.text_field :web_url
%p
  %label{for: 'product_image'}= "Image:"
  %label.hint PNG, JPEG, GIF or WebP, up to 5 MB
  - if f.object.image.present?
    %span.image_current
      = image_tag image_product_path(f.object), alt: f.object.name, class: "image_thumb"
      %label.inline
        = check_box_tag "remove_image", "1", false
        remove image
  = f.file_field :image, accept: "image/png,image/jpeg,image/gif,image/webp", data: { image_drop: true }
