- content_for :title, "Dashboard - "

%h2 Dashboard

.page_navigation
  %ul
    - if @running_events.any?
      %li
        %a{href: "\#running"} running events
    %li
      %a{href: "\#events"} events
    %li
      %a{href: "\#items"} broken items

- if @running_events.any?
  %a{name: "running"}
  %h3 Running events
  - @running_events.each do |event|
    - event_cases = event.event_cases.sort_by { |event_case| event_case.case.name.to_s }
    - finished = event_cases.count { |event_case| event_case.check_list&.checked }
    .running_event
      %h4
        %a{href: event_path(event)}= event.name
        %small= "#{l event.start_date} – #{l event.end_date}, #{event.location}"
      - if event_cases.empty?
        %p No sets are assigned to this event yet.
      - else
        %p= "#{finished} of #{event_cases.size} checklists finished"
        %table.running_sets
          %thead
            %tr
              %th Set
              %th Checklist
              %th Status
          %tbody
            - event_cases.each do |event_case|
              - check_list = event_case.check_list
              - progress = check_list&.progress
              - state = if check_list.nil? then "none" elsif check_list.checked then "finished" elsif check_list.started? then "running" else "open" end
              %tr{class: "check_state_#{state}"}
                %td.no_color
                  %a{href: case_path(event_case.case)}= event_case.case.name
                %td.no_color
                  - if check_list.nil?
                    %a{href: new_check_list_path(event: event_case.event_id, case: event_case.case_id)} create checklist
                  - elsif check_list.checked
                    %a{href: check_list_path(check_list)} show result
                  - else
                    %a{href: edit_check_list_path(check_list)}= check_list.started? ? "continue checking" : "start checking"
                %td
                  - case state
                  - when "none"
                    no checklist yet
                  - when "open"
                    %a{href: check_list_path(check_list), title: "Show the checklist"}= "not started (#{progress[:total]} items)"
                  - when "running"
                    %progress{value: progress[:checked], max: progress[:total]}
                    %a{href: check_list_path(check_list), title: "Show the checklist"}= "#{progress[:checked]} of #{progress[:total]} checked"
                  - else
                    %a{href: check_list_path(check_list), title: "Show the checklist"}= "finished (#{progress[:checked]} of #{progress[:total]} checked)"

%a{name: "events"}
%h3 Upcoming and recent events

- @upcoming_events.group_by{|e| e.start_date.month}.each do |month,events|
  %h4= Date::MONTHNAMES[month]
  %table
    %thead
      %tr
        %th Name
        %th Start date
        %th End date
        %th Location
        %th Transports
        %th Sets
        %th Checklists
    %tbody
      - events.each do |event|
        %tr
          %td.no_color
            %a{href: event_path(event)}= event.name
          %td.no_color
            %a{href: event_path(event)}= l event.start_date
          %td.no_color
            %a{href: event_path(event)}= l event.end_date
          %td.no_color
            %a{href: event_path(event)}= event.location
          %td
            %ul
            - event.transports.each do |c|
              %li
                %a{href: case_path(c)}= c.name
          %td
            %span.cases
              - event.cases.each do |c|
                %a{href: case_path(c)}= c.acronym
          %td
            %span
              - event.check_lists.each do |cl|
                %a{href: check_list_path(cl)}= cl.case.acronym

%a{name: "items"}
%h3 Broken or missing items

- if @broken_or_missing_items.count == 0
  %p no broken or missing items \o/
- else
  - @grouped_items.each do |c,items|
    %h4= c ? c.name : "(no case)"
    %table{border: 1}
      %thead
        %tr
          %th State
          %th Name
          %th Model
          %th Last comment
          %th Actions
      %tbody
        - items.each do |bitem|
          %tr
            - if bitem.missing
              %td.missing{title: "missing"} missing
            - else
              %td.broken{title: "broken"} broken
            %td.no_color
              %a{href: item_path(bitem)}= bitem.name
            %td.no_color
              %a{href: item_path(bitem)}= bitem.model
            - if bitem.item_comments.count == 0
              %td
            - else
              %td.no_color
                %a{href: item_path(bitem)}
                  = "#{bitem.item_comments.first.author}: #{bitem.item_comments.first.comment}"
            %td
              %a{href: item_path(bitem)} show
              %a{href: edit_item_path(bitem)} edit
